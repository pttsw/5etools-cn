		{
			"ENG_name": "Merrow",
			"name": "迈罗人鱼",
			"source": "LFL",
			"entries": [
				{
					"ENG_name": "Merrow",
					"name": "迈罗人鱼",
					"type": "section",
					"entries": [
						"迈罗人鱼主要是水生种族，他们利用洛温-影沼大地上的陆地种族。他们类似于拥有类人躯干和手臂的大型鱼类，尽管他们的形态差异很大。迈罗人鱼通常是能干的战士，但大多数更喜欢在诉诸身体暴力之前用语出惊人进行决斗。"
					]
				}
			]
		},
		{
			"ENG_name": "Merrow Doublespeaker",
			"name": "迈罗人鱼双舌者",
			"source": "LFL",
			"_copy": {
				"ENG_name": "Merrow",
				"name": "迈罗人鱼",
				"source": "LFL",
				"_mod": {
					"entries": {
						"mode": "prependArr",
						"items": [
							{
								"type": "section",
								"entries": [
									"大多数影沼迈罗人鱼都是迈罗双言者，试图欺骗那些不了解它们本性的生物。这些迈罗人鱼的尾刺很危险；双言者可以用它们猛刺或投掷攻击敌人。"
								]
							}
						]
					}
				}
			},
