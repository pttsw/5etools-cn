		{
			"ENG_name": "Noggle Ransacker",
			"name": "诺格尔掠夺者",
			"source": "LFL",
			"_copy": {
				"ENG_name": "Noggles",
				"name": "诺格尔",
				"source": "LFL",
				"_mod": {
					"entries": {
						"mode": "prependArr",
						"items": [
							{
								"type": "section",
								"entries": [
									"诺格尔们不偷偷摸摸\u2014\u2014他们明抢。尽管如此，尽管他们不够谨慎，许多诺格尔选择戴上面具、头巾或薄弱的伪装来隐藏他们的身份。"
								]
							}
						]
					}
				}
			},
			"images": [
				{
					"type": "image",
					"href": {
						"type": "internal",
