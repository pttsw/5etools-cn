		{
			"ENG_name": "Commoner",
			"name": "平民",
			"source": "WttHC",
			"entries": [
				{
					"type": "entries",
					"entries": [
						"平民构成了大多数人的主体，他们不追求魔法天赋、非凡训练或冒险生活。有些人大方、乐于助人，而另一些人在分享自己所拥有的东西时则更为谨慎。"
					]
				}
			],
			"images": [
				{
